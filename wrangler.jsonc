{
  // ⚠️ Este "name" tiene que coincidir EXACTAMENTE con el nombre que
  // Cloudflare le puso a tu Worker al conectar el repo (lo viste en el
  // log de build: "Worker Name: rusted-ranking-web"). Si tu proyecto
  // tiene otro nombre, cambialo acá para que coincida.
  "name": "rusted-ranking-web",
  "main": "src/index.js",
  "compatibility_date": "2026-07-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  // Variables de entorno — configurar en Cloudflare Dashboard > Workers > Settings > Variables
  // "vars": {
  //   "GITHUB_GIST_ID": "8634a68273543e12ecefc85b03506c12",
  //   "GITHUB_REPORTS_GIST_ID": "2314c838396a6758fecf1fd3c5396459",
  //   "GITHUB_TOKEN": "ghp_tu_token_aqui"
  // }
}
